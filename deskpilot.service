[Unit]
Description=DeskPilot
Documentation=file:///home/varshitha/Desktop/DESKPILOT/README.md
After=network.target sound.target

[Service]
Type=simple
WorkingDirectory=/home/varshitha/Desktop/DESKPILOT
ExecStart=/home/varshitha/Desktop/DESKPILOT/.venv/bin/python -m src.deskpilot.main
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=default.target
